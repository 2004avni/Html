<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>General Preference Quiz</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(to right, #74ebd5, #acb6e5);
      padding: 40px;
      margin: 0;
    }
    .container {
      max-width: 550px;
      background: white;
      padding: 30px;
      margin: auto;
      border-radius: 15px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    }
    h2 {
      text-align: center;
      color: #333;
    }
    label {
      display: block;
      margin: 15px 0;
      font-size: 16px;
    }
    input[type="text"], input[type="number"] {
      width: 100%;
      padding: 10px;
      margin-top: 5px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 16px;
    }
    input[type="radio"] {
      margin-right: 8px;
    }
    button {
      display: block;
      width: 100%;
      margin-top: 20px;
      padding: 12px;
      background: #5a67d8;
      color: white;
      font-size: 16px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.3s ease;
    }
    button:hover {
      background: #434190;
    }
    .question, .result {
      display: none;
    }
    .active {
      display: block;
    }
    #summary em {
      color: #5a67d8;
      font-weight: 600;
    }
  </style>
</head>
<body>

<div class="container">
  <div id="userForm" class="active">
    <h2>Welcome to the Preference Quiz</h2>
    <label>Name:
      <input type="text" id="name" required>
    </label>
    <label>Age:
      <input type="number" id="age" required>
    </label>
    <button onclick="startQuiz()">Start Quiz</button>
  </div>

  <div id="quizForm" class="question">
    <h2>Your Preferences</h2>
    <div id="questionBox"></div>
    <button onclick="nextQuestion()">Next</button>
  </div>

  <div id="result" class="result">
    <h2>Quiz Summary</h2>
    <p id="summary"></p>
  </div>
</div>

<script>
  const questions = [
    { question: "Do you prefer Coffee or Tea?", options: ["Coffee", "Tea"] },
    { question: "Ocean or Mountains?", options: ["Ocean", "Mountains"] },
    { question: "Summer or Winter?", options: ["Summer", "Winter"] },
    { question: "Friends or Alone Time?", options: ["Friends", "Alone Time"] },
    { question: "Are you in Stress or Happy?", options: ["Stress", "Happy"] }
  ];

  let userData = { name: "", age: "", answers: [] };
  let currentQuestion = 0;

  function startQuiz() {
    const name = document.getElementById('name').value.trim();
    const age = document.getElementById('age').value.trim();

    if (name && age) {
      userData.name = name;
      userData.age = age;

      document.getElementById('userForm').classList.remove('active');
      document.getElementById('quizForm').classList.add('active');

      showQuestion();
    } else {
      alert("Please enter both name and age.");
    }
  }

  function showQuestion() {
    const q = questions[currentQuestion];
    const questionBox = document.getElementById('questionBox');
    questionBox.innerHTML = `<p style="font-size:18px; font-weight:600;">${q.question}</p>` + 
      q.options.map(option => 
        `<label><input type="radio" name="option" value="${option}"> ${option}</label>`
      ).join('');
  }

  function nextQuestion() {
    const selected = document.querySelector('input[name="option"]:checked');
    if (!selected) {
      alert("Please select an option.");
      return;
    }

    userData.answers.push(selected.value);
    currentQuestion++;

    if (currentQuestion < questions.length) {
      showQuestion();
    } else {
      document.getElementById('quizForm').classList.remove('active');
      document.getElementById('result').classList.add('active');
      showResult();
    }
  }

  function showResult() {
    const summary = `
      <strong>Name:</strong> ${userData.name}<br>
      <strong>Age:</strong> ${userData.age}<br><br>
      <strong>Your Choices:</strong><br>
      ${questions.map((q, i) => `${q.question} <em>${userData.answers[i]}</em>`).join('<br>')}
    `;
    document.getElementById('summary').innerHTML = summary;
  }
</script>

</body>
</html>
